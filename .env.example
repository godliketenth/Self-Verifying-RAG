# ONE of these, matching `provider:` in config.yaml.

# Gemini (default). Free tier, no payment required.
# Create a key at https://aistudio.google.com/apikey
# Note: a Gemini Pro / Google One subscription is NOT API access - the
# AI Studio key above is separate, and free.
GEMINI_API_KEY=

# OpenRouter (alternative). Requires purchased credits.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
